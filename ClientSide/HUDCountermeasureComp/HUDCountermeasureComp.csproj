<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HUDCountermeasureComp</AssemblyName>
    <RootNamespace>HUDCountermeasureComp</RootNamespace>
    <Version>1.0.0</Version>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <NUCLEAR_OPTION_MANAGED_LOCATION>Y:\Games\steamapps\common\Nuclear Option\NuclearOption_Data\Managed</NUCLEAR_OPTION_MANAGED_LOCATION>

    <NoWarn>$(NoWarn);CS1591</NoWarn>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="runtime"/>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.Core" Version="5.*"/>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
    
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(NUCLEAR_OPTION_MANAGED_LOCATION)\Assembly-CSharp.dll" Private="False" Publicize="True"/>
    <Reference Include="UnityEngine" HintPath="$(NUCLEAR_OPTION_MANAGED_LOCATION)\UnityEngine.dll" Private="False" Publicize="True"/>
    <Reference Include="UnityEngine.UI" HintPath="$(NUCLEAR_OPTION_MANAGED_LOCATION)\UnityEngine.UI.dll" Private="False" Publicize="True"/>
    <Reference Include="UnityEngine.CoreModule" HintPath="$(NUCLEAR_OPTION_MANAGED_LOCATION)\UnityEngine.CoreModule.dll" Private="False" Publicize="True"/>
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(NUCLEAR_OPTION_MANAGED_LOCATION)\UnityEngine.TextRenderingModule.dll" Private="False" Publicize="True"/>
    <Reference Include="Mirage" HintPath="$(NUCLEAR_OPTION_MANAGED_LOCATION)\Mirage.dll" Private="False" Publicize="True"/>
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all"/>
  </ItemGroup>
  
</Project>
